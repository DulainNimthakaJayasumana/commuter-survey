rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone can ADD a response; nobody can read, edit or delete from the website.
    // You (the project owner) still see everything in the Firebase console.
    match /responses/{id} {
      allow create: if request.resource.data.keys().hasOnly([
          'status', 'lang', 'version', 'startedAt', 'durationSec', 'submittedAt',
          'A1', 'A2', 'A3', 'A4', 'A5', 'A6', 'A6_other',
          'B1', 'B2', 'B3', 'B4', 'B5', 'B6', 'B7',
          'C1', 'C2', 'C3', 'C4', 'D1', 'D2'
        ])
        && request.resource.data.status in ['complete', 'declined', 'ineligible']
        && request.resource.data.lang in ['en', 'si', 'ta']
        && request.resource.data.submittedAt == request.time
        && (!('A6_other' in request.resource.data) || (request.resource.data.A6_other is string && request.resource.data.A6_other.size() <= 120));
      allow read, update, delete: if false;
    }
  }
}
